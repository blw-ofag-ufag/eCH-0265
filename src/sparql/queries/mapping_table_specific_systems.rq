PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT *
FROM <https://lindas.admin.ch/foag/ech/0265/2>
WHERE {
  # Bind crops in the scheme 'direct payment crops' and some attributes
  ?DirectPaymentCrop skos:inScheme <https://agriculture.ld.admin.ch/crops/agis/1/ConceptScheme> ;
     schema:name ?DirectPaymentCropName ;
     schema:identifier ?DirectPaymentCropIdentifier .
  
  # Make sure the crop is still valid at the time of querying
  FILTER NOT EXISTS {
    ?DirectPaymentCrop schema:validThrough ?validThrough .
    FILTER (?validThrough <= xsd:date(SUBSTR(STR(NOW()), 1, 10)))
  }
  FILTER(LANG(?DirectPaymentCropName) = "de")

  OPTIONAL {
    VALUES ?mappingRelation { skos:exactMatch skos:broadMatch skos:narrowMatch }
    # Target: crops in the scheme 'plant protection crops'
    ?DirectPaymentCrop ?mappingRelation ?PlantProtectionCrop .
    ?PlantProtectionCrop skos:inScheme <https://agriculture.ld.admin.ch/crops/psm/1/ConceptScheme> ;
       schema:name ?PlantProtectionCropName ;
       schema:identifier ?PlantProtectionCropIdentifier .
    FILTER(LANG(?PlantProtectionCropName) = "de")
  }
}
