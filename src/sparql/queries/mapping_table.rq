# Generate a mapping table that can be easily understood and used
# by downstream data consumers.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>

SELECT ?s ?s_name ?s_id ?s_scheme_name ?p ?t ?t_name ?t_id ?t_scheme_name
FROM <https://lindas.admin.ch/foag/ech/0265/2>
WHERE {
  VALUES ?lang { "de" }
  ?s schema:name ?s_name ;
     schema:identifier ?s_id ;
     skos:inScheme ?s_scheme .
  ?s_scheme schema:name ?s_scheme_name .
  FILTER(LANG(?s_name) = ?lang && LANG(?s_scheme_name) = ?lang)
  OPTIONAL {
    VALUES ?p { skos:exactMatch skos:broadMatch skos:narrowMatch }
    ?s ?p ?t .
    ?t schema:name ?t_name ;
       schema:identifier ?t_id ;
       skos:inScheme ?t_scheme .
    ?t_scheme schema:name ?t_scheme_name .
    FILTER(
      ?s_scheme != ?t_scheme &&
      LANG(?t_name) = ?lang &&
      LANG(?t_scheme_name) = ?lang
    )
  }
}
ORDER BY ?s_scheme_name ?t_scheme_name ?s_name ?t_name