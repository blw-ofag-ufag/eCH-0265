# ==============================================================================
# PREFIXES
# ==============================================================================

# Project-specific namespaces/qnames
@prefix eCH-0265:        <https://agriculture.ld.admin.ch/eCH-0265/2/> .
@prefix psm:             <https://agriculture.ld.admin.ch/crops/psm/1/> .
@prefix agis:            <https://agriculture.ld.admin.ch/crops/agis/1/> .
@prefix naebi:           <https://agriculture.ld.admin.ch/crops/naebi/1/> .

# Globally used namespaces/qnames
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .
@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# DOCUMENT METADATA
# ------------------------------------------------------------------------------
# The metadata of this document is described as it is required by SHACL PLAY!
# Visit https://shacl-play.sparna.fr/play/doc for more on this.
# ==============================================================================

eCH-0265: a owl:Ontology ;
    dcterms:creator "Damian Oswald, Lea Stauber, Marc Beringer, Christian Wilda" ;
    dcterms:title "RDF master and reference data about crops"@en ;
    dcterms:created "2026-03-05"^^xsd:date ;
    dcterms:modified "2026-05-04"^^xsd:date ;
    dcterms:abstract
"""
This project addresses the challenge of fragmented agricultural crop data within the Swiss federal administration, where essential systems all use separate, non-harmonized crop terminologies.
This lack of a "single source of truth" creates significant integration hurdles for digital tools.
In this project, we propose a unified master data system for crops and crop-related objects.
"""@en .

# ==============================================================================
# CULTIVATION TYPE
# ==============================================================================

eCH-0265:CultivationType a sh:NodeShape, rdfs:Class ;
    rdfs:label "Cultivation type"@en,
        "Nutzungstyp"@de ;
    rdfs:comment "Die Kernklasse für die Klassifikation von «Kulturen», bzw. Landnutzungen. Eine (teilweise) Übersetzung anderer Kulturarten ist über die mit dieser Klasse modellierte Hierarchie möglich. Für die allgemeine Hierarchiemodellierung wird das [*RDF-Schema* (RDFS)](https://www.w3.org/TR/rdf-schema/) sowie die [*Web Ontology Language* (OWL)](https://www.w3.org/TR/owl-guide/) verwendet."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type owl:intersectionOf owl:unionOf owl:equivalentClass skos:exactMatch skos:broadMatch skos:narrowMatch eCH-0265:managementIntensity eCH-0265:botanicalPlant schema:image ) ;
    # Require AT LEAST ONE of the following relationships:
    # - a parent class (rdfs:subClassOf),
    # - an intersection definition (owl:intersectionOf),
    # - or being part of a parent's unionOf list (^owl:unionOf).
    sh:or (
        [ sh:property [ sh:path rdfs:subClassOf ; sh:minCount 1 ] ]
        [ sh:property [ sh:path owl:intersectionOf ; sh:minCount 1 ] ]
        [ sh:property [ 
            sh:path (
                [ sh:inversePath rdf:first ]
                [ sh:zeroOrMorePath [ sh:inversePath rdf:rest ] ]
                [ sh:inversePath owl:unionOf ]
            ) ; 
            sh:minCount 1 
        ] ]
    ) ;
    sh:property
    [
        sh:order 1 ;
        sh:path schema:name ;
        sh:name "Name"@de,
            "Name"@en ;
        sh:description "Name of this cultivation type."@en ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "de" "fr" "it" "en" ) ;
        sh:uniqueLang true ;
    ],
    [
        sh:order 2 ;
        sh:name "Alternate name"@en, "Alias"@de ;
        sh:path schema:alternateName ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
    ],
    [
        sh:order 3 ;
        sh:path schema:description ;
        sh:name "Description"@en,
            "Beschreibung"@de ;
        sh:description "Textual description of this cultivation type."@en ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "de" "fr" "it" "en" ) ;
        sh:uniqueLang true ;
    ],
    [
        sh:order 5 ;
        sh:name "Parent cultivation type"@en ;
        sh:path rdfs:subClassOf ;
        sh:or (
            [ sh:class eCH-0265:CultivationType ]
            [ sh:hasValue eCH-0265:Cultivation ]
        ) ;
    ],
    [
        sh:order 8 ;
        sh:path owl:disjointWith ;
        sh:nodeKind sh:IRI ;
        sh:class eCH-0265:CultivationType ;
    ] .

# ==============================================================================
# Direct payment crop (AGIS)
# ==============================================================================

eCH-0265:DirectPaymentAreaCategory a sh:NodeShape, rdfs:Class ;
    rdfs:label "Flächenkategorie Direktzahlung"@de,
        "Direct payment area category"@en ;
    rdfs:comment "Level 1 in the AGIS direct payment crops hierarchy."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:narrower ) ;
    sh:property
        [
            sh:order 1 ;
            sh:path skos:topConceptOf ;
            sh:hasValue agis:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:path skos:inScheme ;
            sh:hasValue agis:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:minCount 1 ;
            sh:path schema:name ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:cultivationType .

eCH-0265:DirectPaymentCrop a sh:NodeShape, rdfs:Class ;
    rdfs:label "Direct payment crop"@en,
        "Direktzahlungskultur"@de ;
    rdfs:comment "A classification scheme built for the Swiss direct payment system"@en,
        "Beschreibt eine Liste der «Kulturen», die gemäss Direktzahlungsverordnung (DZV) im Bereich Landwirtschaft relevant sind. Diese «Kulturen» werden für den Direktzahlungsvollzug verwendet. Sie entsprechen den Hauptkulturen."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:narrower ) ;    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "schema:validFrom must be less than or equal to schema:validTo" ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT $this ?validFrom ?validTo
            WHERE {
                $this schema:validFrom ?validFrom .
                $this schema:validTo ?validTo .
                FILTER (?validFrom > ?validTo)
            }
        """ ;
    ] ;
    sh:property
        [
            sh:order 1 ;
            sh:path skos:broader ;
            sh:class eCH-0265:DirectPaymentAreaCategory ; 
            sh:minCount 0 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:path skos:inScheme ;
            sh:hasValue agis:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Identifikator"@de ;
            sh:description "Der LNF-Code, auch Kulturcode genannt, ist der allgemein gebräuchliche Identifikator für Direktzahlungskulturen in der Schweiz."@de ;
            sh:name "LNF-Code"@de ;
            sh:description "Auch Kulturcode genannt, ist der allgemein gebräuchliche Identifikator für Direktzahlungskulturen in der Schweiz."@de ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schema:identifier ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:string ;
        ],
        [
            sh:order 2 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:description "Die offizielle Bezeichnung dieser Direktzahlungskultur, abgeglichen mit der Landwirtschaftlichen Begriffsverordnung (LBV)."@de ;
            sh:minCount 1 ;
            sh:path schema:name ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:cultivationType,
        [
            sh:order 7 ;
            sh:name "Gültig von"@de ;
            sh:description "Ab welchem Jahr wurde diese Direktzahlungskultur offiziell verwendet?"@de ;
            sh:maxCount 1 ;
            sh:minInclusive 1999 ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:integer ;
            sh:path schema:validFrom ;
        ],
        [
            sh:order 8 ;
            sh:name "Gültig bis"@de ;
            sh:description "Bis in welchem Jahr wurde diese Direktzahlungskultur offiziell verwendet?"@de ;
            sh:maxCount 1 ;
            sh:path schema:validTo ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:integer ;
        ] .

# ==============================================================================
# Nutrient Balance Crop (Suisse Bilanz, Näbi, Naebi)
# ==============================================================================

eCH-0265:NutrientBalanceCropCategory a sh:NodeShape, rdfs:Class ;
    rdfs:label "Nährstoffbilanz-Kultivierungskategorie"@de,
        "Nutrient balance cultivation category"@en ;
    rdfs:comment "Oberste Hierarchieebene der Kulturen im Nährstoffbilanz-Berechnungsservice, dient der reinen Strukturierung."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:broader skos:narrower ) ;    
    sh:property
        [
            sh:order 1 ;
            sh:name "Concept Scheme"@en, "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Top Concept Of"@en, "Oberstes Konzept von"@de ;
            sh:path skos:topConceptOf ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:path schema:name ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:identifier,
        eCH-0265:cultivationType .

eCH-0265:NutrientBalanceCropSubCategory a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Nährstoffbilanz-Kultivierungsunterkategorie"@de,
        "Nutrient balance cultivation subcategory"@en ;
    rdfs:comment "Mittlere Hierarchieebene der Kulturen im Nährstoffbilanz-Berechnungsservice."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:broader skos:narrower skos:topConceptOf ) ;
    sh:property
        [
            sh:order 1 ;
            sh:name "Concept Scheme"@en, "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:path schema:name ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:identifier,
        eCH-0265:cultivationType .

eCH-0265:NutrientBalanceCrop a sh:NodeShape, rdfs:Class ;
    rdfs:label "Agronomische Kulturkategorie"@de,
        "Nutrient balance agronomic crop category"@en ;
    rdfs:comment "Unterste Hierarchieebene, welche die eigentlichen Kulturen mit spezifischen agronomischen Eigenschaften für die Suisse-Bilanz beinhaltet."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:broader skos:narrower ) ;
    sh:property
        eCH-0265:identifier,
        [
            sh:order 2 ;
            sh:name "Concept Scheme"@en,
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:path schema:name ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        [
            sh:order 5 ;
            sh:name "Unterkategorie"@de,
                "Subcategory"@en ;
            sh:path eCH-0265:cultivationSubCategory ;
            sh:class eCH-0265:NutrientBalanceCropSubCategory ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
        ],
        [
            sh:order 6 ;
            sh:name "Kategorie"@de,
                "Category"@en ;
            sh:path eCH-0265:cultivationCategory ;
            sh:class eCH-0265:NutrientBalanceCropCategory ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
        ],
        eCH-0265:identifier,
        eCH-0265:cultivationType .

# ==============================================================================
# Plant protection crop (from the Swiss registry of plant protection products)
# ==============================================================================

eCH-0265:PlantProtectionCrop a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Pflanzenschutzmittel-Kultur"@de,
        "Plant protection crop"@en ;
    rdfs:comment "Kultur, wie sie im [Pflanzenschutzmittelverzeichnis](https://psm.admin.ch/) modelliert ist. Diese Kulturen sind über die Attribute `schema:isPartOf` sowie `schema:hasPart` hierarchisch organisiert."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:narrower ) ;
    sh:property
        eCH-0265:identifier,
        [
            sh:order 1.5 ;
            sh:name "Concept Scheme"@en, 
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue psm:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:description "Der in Infofito eingetragene Name dieser Kultur."@de ;
            sh:maxCount 4 ;
            sh:minCount 2 ;
            sh:languageIn ( "de" "fr" "it" "en" ) ;
            sh:uniqueLang true ;
            sh:nodeKind sh:Literal ;
            sh:path schema:name ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:cultivationType,
        [
            sh:order 4 ;
            sh:name "Version"@de ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schema:version ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:integer ;
        ],
        [
            sh:order 5 ;
            sh:name "Parent crop"@en,
                "Überkultur"@de ;
            sh:path skos:broader ;
            sh:minCount 0 ;
            sh:maxCount 2 ;
            sh:nodeKind sh:IRI ;
            sh:class skos:Concept ;
            sh:node eCH-0265:PlantProtectionCrop ;
        ] .

# ==============================================================================
# GENERIC PROPERTIES TO BE RE-USED
# ==============================================================================

eCH-0265:identifier a sh:PropertyShape ;
    sh:name "Identifier"@en,
        "Identifikator"@de ;
    sh:order 1 ;
    sh:path schema:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string .

eCH-0265:cultivationType a sh:PropertyShape ;
    sh:order 0 ;
    sh:name "Kultivierungstyp"@de,
        "Cultivation type"@en ;
    sh:description "Der dieser bereichsspezifischen Kultur korrespondierende Kultivierungstyp in der Kulturenontologie."@de ;
    sh:path skos:exactMatch ;
    sh:qualifiedValueShape [
        sh:class eCH-0265:CultivationType ;
    ] ;
    sh:qualifiedMinCount 0 ;
    sh:qualifiedMaxCount 1 .