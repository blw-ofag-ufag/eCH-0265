# ==============================================================================
# PREFIXES
# ==============================================================================

# Project-specific namespaces/qnames
@prefix eCH-0265:        <https://agriculture.ld.admin.ch/eCH-0265/2/> .
@prefix psm:             <https://agriculture.ld.admin.ch/crops/psm/1/> .
@prefix naebi:           <https://agriculture.ld.admin.ch/crops/naebi/1/> .
@prefix agis:            <https://agriculture.ld.admin.ch/crops/agis/1/> .
@prefix mgdm:            <https://agriculture.ld.admin.ch/crops/mgdm/1/> .

# Globally used namespaces/qnames
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .
@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# DOCUMENT METADATA
# ------------------------------------------------------------------------------
# The metadata of this document is described as it is required by SHACL PLAY!
# Visit https://shacl-play.sparna.fr/play/doc for more on this.
# ==============================================================================

eCH-0265: a owl:Ontology ;
    dcterms:creator "Damian Oswald, Lea Stauber, Marc Beringer, Christian Wilda" ;
    dcterms:title "eCH-0265 Datenmodell"@de,
        "eCH-0265 Data Model"@en ;
    dcterms:created "2026-03-05"^^xsd:date ;
    dcterms:modified "2026-05-04"^^xsd:date .

# ==============================================================================
# CULTIVATION TYPE
# ==============================================================================

eCH-0265:CultivationType a sh:NodeShape, rdfs:Class ;
    rdfs:label "Cultivation type"@en,
        "Nutzungstyp"@de ;
    rdfs:comment "Die Kernklasse für die Klassifikation von «Kulturen», bzw. Landnutzungen. Eine (teilweise) Übersetzung anderer Kulturarten ist über die mit dieser Klasse modellierte Hierarchie möglich. Für die allgemeine Hierarchiemodellierung wird das [*RDF-Schema* (RDFS)](https://www.w3.org/TR/rdf-schema/) sowie die [*Web Ontology Language* (OWL)](https://www.w3.org/TR/owl-guide/) verwendet."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type owl:intersectionOf owl:unionOf owl:equivalentClass skos:exactMatch skos:broadMatch skos:narrowMatch eCH-0265:managementIntensity eCH-0265:botanicalPlant schema:image ) ;
    # Require AT LEAST ONE of the following relationships:
    # - a parent class (rdfs:subClassOf),
    # - an intersection definition (owl:intersectionOf),
    # - or being part of a parent's unionOf list (^owl:unionOf).
    sh:or (
        [ sh:property [ sh:path rdfs:subClassOf ; sh:minCount 1 ] ]
        [ sh:property [ sh:path owl:intersectionOf ; sh:minCount 1 ] ]
        [ sh:property [ 
            sh:path (
                [ sh:inversePath rdf:first ]
                [ sh:zeroOrMorePath [ sh:inversePath rdf:rest ] ]
                [ sh:inversePath owl:unionOf ]
            ) ; 
            sh:minCount 1 
        ] ]
    ) ;
    sh:property
    [
        sh:order 1 ;
        sh:path schema:name ;
        sh:name "Name"@de,
            "Name"@en ;
        sh:description "Die präferierte Bezeichnung der Nutzungsart. Sie ist viersprachig gegeben (de, fr, it, en) und beginnt immer mit einem Grossbuchstaben. Der Name ist möglichst schlank gehalten, bleibt aber eindeutig für die Nutzungsart. Klammerbemerkungen sind im Namen nicht erlaubt."@de,
            "The preferred label of the cultivation type. It is given in four languages (de, fr, it, en) and always begins with a capital letter. The name is kept as lean as possible while remaining unambiguous for the cultivation type. Parenthetical remarks are not permitted in the name."@en ;
        sh:minCount 4 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "de" "fr" "it" "en" ) ;
        sh:uniqueLang true ;
        sh:pattern "^[A-ZÀ-ÖØ-Þ]" ;
    ],
    [
        sh:order 2 ;
        sh:name "Alternate name"@en,
            "Alias"@de ;
        sh:description "Eine alternative Bezeichnung (also ein Synonym) der Nutzungsart. Beispiel: Stielmangold oder Rippenmangold sind Synonyme für Krautstiel. Diese Synonyme können für verbesserte Suchfunktionen gebraucht werden."@de,
            "An alternative label (i.e. a synonym) of the cultivation type. For example, «Stielmangold» and «Rippenmangold» are synonyms for «Krautstiel» (chard). Such synonyms can be used to improve search functionality."@en ;
        sh:path schema:alternateName ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
    ],
    [
        sh:order 3 ;
        sh:path schema:description ;
        sh:name "Description"@en,
            "Beschreibung"@de ;
        sh:description "Falls der Name der Nutzungsart nicht selbsterklärend ist, kann eine weiterführende Beschreibung beigelegt werden."@de,
            "If the name of the cultivation type is not self-explanatory, a further description can be supplied."@en ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "de" "fr" "it" "en" ) ;
        sh:uniqueLang true ;
    ],
    [
        sh:order 5 ;
        sh:name "Parent cultivation type"@en,
            "Übergeordneter Nutzungstyp"@de ;
        sh:path rdfs:subClassOf ;
        sh:or (
            [ sh:class eCH-0265:CultivationType ]
            [ sh:hasValue eCH-0265:Cultivation ]
            [ 
                sh:nodeKind sh:BlankNode ;
                sh:class owl:Class ]
        ) ;
    ],
    [
        sh:order 8 ;
        sh:path owl:disjointWith ;
        sh:nodeKind sh:IRI ;
        sh:class eCH-0265:CultivationType ;
    ] .

# ==============================================================================
# Direct payment crop (AGIS and minimal geodata model «Landwirtschaftliche Kulturflächen»)
# ==============================================================================

eCH-0265:DirectPaymentAreaCategory a sh:NodeShape, rdfs:Class ;
    rdfs:label "Flächenkategorie Direktzahlung"@de,
        "Direct payment area category"@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:narrower ) ;
    sh:property
        [
            sh:order 1 ;
            sh:path skos:topConceptOf ;
            sh:in ( agis:ConceptScheme mgdm:ConceptScheme ) ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Concept Scheme"@en,
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:in ( agis:ConceptScheme mgdm:ConceptScheme ) ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:minCount 1 ;
            sh:path schema:name ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
            sh:languageIn ( "de" "fr" "it" "en" ) ;
            sh:uniqueLang true ;
        ],
        eCH-0265:cultivationType .

eCH-0265:DirectPaymentCrop a sh:NodeShape, rdfs:Class ;
    rdfs:label "Direct payment crop"@en,
        "Direktzahlungskultur"@de ;
    rdfs:comment "A classification scheme built for the Swiss direct payment system"@en,
        "Beschreibt eine Liste der «Kulturen», die gemäss Direktzahlungsverordnung (DZV) im Bereich Landwirtschaft relevant sind. Diese «Kulturen» werden für den Direktzahlungsvollzug verwendet. Sie entsprechen den Hauptkulturen."@de ;
    sh:closed true ;
    # `sh:closed` only takes the property shapes of this very node shape into account.
    # The properties that the subclasses eCH-0265:AgisCrop and eCH-0265:GeodataCrop
    # add (skos:broader, eCH-0265:overlapping) are therefore listed here explicitly,
    # so that they are not reported as violations on instances of the subclasses.
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:narrower skos:broader eCH-0265:overlapping ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "schema:validFrom must be less than or equal to schema:validTo" ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT $this ?validFrom ?validTo
            WHERE {
                $this schema:validFrom ?validFrom .
                $this schema:validTo ?validTo .
                FILTER (?validFrom > ?validTo)
            }
        """ ;
    ] ;
    sh:property
        [
            sh:order 2 ;
            sh:name "Concept Scheme"@en,
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:in ( agis:ConceptScheme mgdm:ConceptScheme ) ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Identifikator"@de ;
            sh:description "Der LNF-Code, auch Kulturcode genannt, ist der allgemein gebräuchliche Identifikator für Direktzahlungskulturen in der Schweiz."@de ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schema:identifier ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:string ;
        ],
        [
            sh:order 2 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:description "Die offizielle Bezeichnung dieser Direktzahlungskultur, abgeglichen mit der Landwirtschaftlichen Begriffsverordnung (LBV)."@de ;
            sh:minCount 1 ;
            sh:path schema:name ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
            sh:languageIn ( "de" "fr" "it" "en" ) ;
            sh:uniqueLang true ;
        ],
        eCH-0265:cultivationType,
        [
            sh:order 7 ;
            sh:name "Gültig von"@de ;
            sh:description "Ab welchem Jahr wurde diese Direktzahlungskultur offiziell verwendet?"@de ;
            sh:maxCount 1 ;
            sh:minInclusive 1999 ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:integer ;
            sh:path schema:validFrom ;
        ],
        [
            sh:order 8 ;
            sh:name "Gültig bis"@de ;
            sh:description "Bis in welchem Jahr wurde diese Direktzahlungskultur offiziell verwendet?"@de ;
            sh:maxCount 1 ;
            sh:path schema:validTo ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:integer ;
        ] .

# ==============================================================================
# AGIS crop (Strukturdatenerhebung, agrarpolitisches Informationssystem AGIS)
# ==============================================================================

eCH-0265:AgisCrop a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf eCH-0265:DirectPaymentCrop ;
    rdfs:label "AGIS-Kultur"@de,
        "AGIS crop"@en ;
    rdfs:comment "Direktzahlungskultur, wie sie im Rahmen der Strukturdatenerhebung erfasst und an das agrarpolitische Informationssystem (AGIS) des Bundes übermittelt wird. Die Klasse ist als Unterklasse der Direktzahlungskultur modelliert und erbt deren Eigenschaften."@de ;
    sh:property
        [
            sh:order 1 ;
            sh:name "Flächenkategorie"@de,
                "Area category"@en ;
            sh:description "Die Flächenkategorie Direktzahlung, welcher diese Kultur zugeordnet ist."@de ;
            sh:path skos:broader ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:class eCH-0265:DirectPaymentAreaCategory ;
        ],
        [
            sh:order 2 ;
            sh:name "Concept Scheme"@en,
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue agis:ConceptScheme ;
        ] .

# ==============================================================================
# Nutrient Balance Crop (Suisse Bilanz, Näbi, Naebi)
# ==============================================================================

eCH-0265:NutrientBalanceCropCategory a sh:NodeShape, rdfs:Class ;
    rdfs:label "Nährstoffbilanz-Kultivierungskategorie"@de,
        "Nutrient balance cultivation category"@en ;
    rdfs:comment "Oberste Hierarchieebene der Kulturen im Nährstoffbilanz-Berechnungsservice, dient der reinen Strukturierung."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:broader skos:narrower ) ;    
    sh:property
        [
            sh:order 1 ;
            sh:name "Concept Scheme"@en, "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Top Concept Of"@en, "Oberstes Konzept von"@de ;
            sh:path skos:topConceptOf ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:path schema:name ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:identifier,
        eCH-0265:cultivationType .

eCH-0265:NutrientBalanceCropSubCategory a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Nährstoffbilanz-Kultivierungsunterkategorie"@de,
        "Nutrient balance cultivation subcategory"@en ;
    rdfs:comment "Mittlere Hierarchieebene der Kulturen im Nährstoffbilanz-Berechnungsservice."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:broader skos:narrower skos:topConceptOf ) ;
    sh:property
        [
            sh:order 1 ;
            sh:name "Concept Scheme"@en, "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:path schema:name ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:identifier,
        eCH-0265:cultivationType .

eCH-0265:NutrientBalanceCrop a sh:NodeShape, rdfs:Class ;
    rdfs:label "Agronomische Kulturkategorie"@de,
        "Nutrient balance agronomic crop category"@en ;
    rdfs:comment "Unterste Hierarchieebene, welche die eigentlichen Kulturen mit spezifischen agronomischen Eigenschaften für die Suisse-Bilanz beinhaltet."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:broader skos:narrower ) ;
    sh:property
        eCH-0265:identifier,
        [
            sh:order 2 ;
            sh:name "Concept Scheme"@en,
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue naebi:ConceptScheme ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 3 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:path schema:name ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype rdf:langString ;
        ],
        [
            sh:order 5 ;
            sh:name "Unterkategorie"@de,
                "Subcategory"@en ;
            sh:path eCH-0265:cultivationSubCategory ;
            sh:class eCH-0265:NutrientBalanceCropSubCategory ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
        ],
        [
            sh:order 6 ;
            sh:name "Kategorie"@de,
                "Category"@en ;
            sh:path eCH-0265:cultivationCategory ;
            sh:class eCH-0265:NutrientBalanceCropCategory ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
        ],
        eCH-0265:identifier,
        eCH-0265:cultivationType .

# ==============================================================================
# Plant protection crop (from the Swiss registry of plant protection products)
# ==============================================================================

eCH-0265:PlantProtectionCrop a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Pflanzenschutzmittel-Kultur"@de,
        "Plant protection crop"@en ;
    rdfs:comment "Kultur, wie sie im [Pflanzenschutzmittelverzeichnis](https://psm.admin.ch/) modelliert ist. Diese Kulturen sind über die Attribute `schema:isPartOf` sowie `schema:hasPart` hierarchisch organisiert."@de ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type skos:exactMatch skos:broadMatch skos:narrowMatch skos:narrower ) ;
    sh:property
        eCH-0265:identifier,
        [
            sh:order 1.5 ;
            sh:name "Concept Scheme"@en, 
                "Konzeptschema"@de ;
            sh:path skos:inScheme ;
            sh:hasValue psm:ConceptScheme ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
        ],
        [
            sh:order 2 ;
            sh:name "Name"@de,
                "Name"@en ;
            sh:description "Der in Infofito eingetragene Name dieser Kultur."@de ;
            sh:maxCount 4 ;
            sh:minCount 2 ;
            sh:languageIn ( "de" "fr" "it" "en" ) ;
            sh:uniqueLang true ;
            sh:nodeKind sh:Literal ;
            sh:path schema:name ;
            sh:datatype rdf:langString ;
        ],
        eCH-0265:cultivationType,
        [
            sh:order 4 ;
            sh:name "Version"@de ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schema:version ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:integer ;
        ],
        [
            sh:order 5 ;
            sh:name "Parent crop"@en,
                "Überkultur"@de ;
            sh:path skos:broader ;
            sh:minCount 0 ;
            sh:maxCount 2 ;
            sh:nodeKind sh:IRI ;
            sh:class skos:Concept ;
            sh:node eCH-0265:PlantProtectionCrop ;
        ] .

# ==============================================================================
# Geodata crop (minimal geodata model «Landwirtschaftliche Kulturflächen», 153.1)
# ==============================================================================

eCH-0265:GeodataCrop a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf eCH-0265:DirectPaymentCrop ;
    rdfs:label "Geodaten-Nutzungsart"@de,
        "Geodata crop"@en ;
    rdfs:comment "Nutzungsart gemäss dem Katalog `LNF_Katalog_Nutzungsart` des minimalen Geodatenmodells «Landwirtschaftliche Kulturflächen» (Geobasisdaten-Identifikator 153, Modell 153.1 Nutzungsflächen). Mit diesen Nutzungsarten erfassen die Kantone die landwirtschaftlichen Nutzungsflächen geometrisch und stellen sie über [geodienste.ch](https://geodienste.ch/) bereit. Der Katalog basiert auf den Direktzahlungskulturen, enthält jedoch zusätzliche (aggregierende) Nutzungsarten, weitere Attribute sowie eine eigene, auf das Geodatenmodell bezogene zeitliche Gültigkeit. Er wird vom Bundesamt für Landwirtschaft als INTERLIS-Katalog unter <https://models.geo.admin.ch/BLW/> publiziert. Die Klasse ist als Unterklasse der Direktzahlungskultur modelliert und erbt deren Eigenschaften (Identifikator, Name, Nutzungstyp, zeitliche Gültigkeit); nachfolgend sind nur die geodatenspezifischen Ergänzungen und Einschränkungen aufgeführt."@de ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The aggregating land use type of a geodata crop must not itself be aggregated" ;
        sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX eCH-0265: <https://agriculture.ld.admin.ch/eCH-0265/2/>
            SELECT $this ?aggregate
            WHERE {
                $this skos:broader ?aggregate .
                ?aggregate a eCH-0265:GeodataCrop ;
                    skos:broader ?grandparent .
                ?grandparent a eCH-0265:GeodataCrop .
            }
        """ ;
    ],
    [
        a sh:SPARQLConstraint ;
        sh:message "A geodata crop that is not overlapping must reach a main category via skos:broader" ;
        sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX eCH-0265: <https://agriculture.ld.admin.ch/eCH-0265/2/>
            SELECT $this
            WHERE {
                $this eCH-0265:overlapping false .
                FILTER NOT EXISTS {
                    $this skos:broader+ ?category .
                    ?category a eCH-0265:DirectPaymentAreaCategory .
                }
            }
        """ ;
    ] ;
    sh:property
        [
            sh:order 1 ;
            sh:name "Übergeordnete Kultur"@de,
                "Parent crop"@en ;
            sh:description "Entweder die Hauptkategorie, welcher diese Nutzungsart im Geodatenmodell zugeordnet ist, oder – wenn sie in einer aggregierenden Nutzungsart zusammengefasst wird – diese aggregierende Nutzungsart, welche ihrerseits auf die Hauptkategorie zeigt."@de ;
            sh:path skos:broader ;
            sh:maxCount 1 ;
            sh:or (
                [ sh:class eCH-0265:DirectPaymentAreaCategory ]
                [ sh:class eCH-0265:GeodataCrop ]
            ) ;
        ],
        [
            sh:order 2 ;
            sh:path skos:inScheme ;
            sh:hasValue mgdm:ConceptScheme ;
        ],
        [
            sh:order 3 ;
            sh:name "Überlagernd"@de,
                "Overlapping"@en ;
            sh:description "Gibt an, ob es sich um eine überlagernde Nutzung handelt. Überlagernde Nutzungen (z.B. Bäume oder Ackerschonstreifen) werden geometrisch über anderen Nutzungsflächen erfasst. Überlagernd erfasste Nutzungsarten haben kein übergeordnetes Konzept."@de ;
            sh:path eCH-0265:overlapping ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:boolean ;
        ] .

# ==============================================================================
# GENERIC PROPERTIES TO BE RE-USED
# ==============================================================================

eCH-0265:identifier a sh:PropertyShape ;
    sh:name "Identifier"@en,
        "Identifikator"@de ;
    sh:order 1 ;
    sh:path schema:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string .

eCH-0265:cultivationType a sh:PropertyShape ;
    sh:order 0 ;
    sh:name "Kultivierungstyp"@de,
        "Cultivation type"@en ;
    sh:description "Der dieser bereichsspezifischen Kultur korrespondierende Kultivierungstyp in der Kulturenontologie."@de ;
    sh:path eCH-0265:exactMatch ;
    sh:class eCH-0265:CultivationType ;
    sh:minCount 0 ;
    sh:maxCount 1 .