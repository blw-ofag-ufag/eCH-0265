# ==============================================================================
# PREFIXES
# ==============================================================================

# Project-specific namespaces/qnames
@prefix eCH-0265:        <https://agriculture.ld.admin.ch/eCH-0265/2/> .
@prefix cultivationtype: <https://agriculture.ld.admin.ch/crops/cultivationtype/> .
@prefix taxon:           <https://agriculture.ld.admin.ch/crops/taxon/> .
@prefix intensity:       <https://agriculture.ld.admin.ch/crops/intensity/> .

# Globally used namespaces/qnames
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .


# ==============================================================================
# ONTOLOGY METADATA
# ==============================================================================

cultivationtype: a owl:Ontology ;
    dcterms:title "Kulturen-Taxonomie"@de,
        "Crop-Taxonomy"@en .

# ==============================================================================
# ENUMERATIONS USED IN THIS DOCUMENT
# ==============================================================================

# Intensity levels -------------------------------------------------------------
intensity:Extensive  schema:name  "extensiv"@de,        "Extensive"@en .
intensity:Low        schema:name  "wenig intensiv"@de,  "Low intensity"@en .
intensity:Medium     schema:name  "mittelintensiv"@de,  "Medium intensity"@en .
intensity:Intensive  schema:name  "intensiv"@de,        "Intensive"@en .

# ==============================================================================
# CULTIVATION TYPES
# ==============================================================================

cultivationtype:1 a eCH-0265:CultivationType ;
    schema:name "Ackerfläche"@de,
        "Arable land"@en,
        "Terres cultivées"@fr,
        "Superficie coltiva"@it ;
    schema:alternateName "Ackerkulturen"@de,
        "Ackerbau"@de,
        "Domaine app. grande culture"@fr,
        "Grande culture en général"@fr ;
    schema:description "Umfasst Flächen, die im Rahmen der Fruchtfolge für den Anbau von einjährigen oder temporären Kulturen genutzt werden."@de ;
    rdfs:subClassOf cultivationtype:464 .

cultivationtype:2 a eCH-0265:CultivationType ;
    schema:name "Dauerwiesen"@de,
        "Permanent grasslands"@en,
        "Prairies permanentes"@fr,
        "Prati perenni"@it ;
    schema:description "Als Dauerwiese gilt die Fläche, die jährlich mindestens ein Mal zur Futtergewinnung gemäht wird."@de ;
    rdfs:subClassOf cultivationtype:21 .

cultivationtype:3 a eCH-0265:CultivationType ;
    schema:name "Dauerweiden"@de,
        "Permanent pastures"@en,
        "Pâturages permanents"@fr,
        "Pascoli perenni"@it ;
    schema:description "Als Dauerweide gilt die Fläche mit ausschliesslicher Weidenutzung. Verbuschte oder unproduktive Teile einer Weide sind nicht anrechenbar. Anrechenbar sind hingegen die Weideflächen von Waldweiden ausserhalb der Sömmerungsfläche (Art. 19 LBV)."@de ;
    rdfs:subClassOf cultivationtype:21 ;
    owl:disjointWith cultivationtype:2 .

cultivationtype:4 a eCH-0265:CultivationType ;
    schema:name "Reben"@de,
        "Vines"@en,
        "Vignobles"@fr,
        "Vigna"@it ;
    schema:alternateName "Weinbau"@de ,
        "Weinreben"@de;
    rdfs:subClassOf cultivationtype:465 ;
    owl:unionOf ( cultivationtype:701 cultivationtype:735 ) .

cultivationtype:5 a eCH-0265:CultivationType ;
    schema:name "Obstanlagen"@de,
        "Orchards"@en,
        "Cultures fruitières"@fr,
        "Frutteti"@it ;
    schema:alternateName "Obstbau"@de,
        "Allgemeiner Obstbau"@de ;
    rdfs:subClassOf cultivationtype:465,
        cultivationtype:467 .

cultivationtype:6 a eCH-0265:CultivationType ;
    schema:name "Übrige Dauerkulturen"@de,
        "Other perennial crops"@en,
        "Autres cultures pérennes"@fr,
        "Altre colture perenni"@it ;
    rdfs:subClassOf cultivationtype:467 .

cultivationtype:7 a eCH-0265:CultivationType ;
    schema:name "Geschützter Anbau"@de,
        "Protected crops"@en,
        "Cultures protégées"@fr,
        "Colture protette tutto l’anno"@it ;
    schema:alternateName "Geschützte Kulturen"@de ;
    rdfs:subClassOf eCH-0265:Cultivation .

cultivationtype:8 a eCH-0265:CultivationType ;
    schema:name "Streueflächen"@de,
        "Spreading Areas"@en,
        "Surfaces à litière"@fr,
        "Terreni da strame"@it ;
    schema:description "Als Streueflächen gelten extensiv genutzte Flächen an Nass- und Feuchtstandorten, die alle ein bis drei Jahre geschnitten werden und deren Ertrag nur ausnahmsweise als Futter auf dem Betrieb verwendet wird."@de,
        "Par surfaces à litière, on entend les surfaces cultivées d’une manière extensive et situées dans des lieux humides et marécageux, qui sont fauchées une fois par an au plus et tous les trois ans au moins, et dont la récolte n’est utilisée qu’exceptionnellement comme fourrage dans l’exploitation."@fr,
        "Per terreni da strame s’intendono le superfici sfruttate in modo estensivo in luoghi paludosi e umidi che vengono falciate al massimo una volta all’anno e almeno ogni due o tre anni e il cui raccolto viene utilizzato solo eccezionalmente come foraggio all’interno dell’azienda."@it ;
    rdfs:subClassOf cultivationtype:464 .

cultivationtype:9 a eCH-0265:CultivationType ;
    schema:name "Hecken sowie Feld- und Ufergehölze"@de,
        "Hedgerows field and riparian copses"@en,
        "Haies et bosquets et berges boisées"@fr,
        "Siepi e boschetti campestri e rivieraschi"@it ;
    rdfs:subClassOf eCH-0265:Cultivation .

cultivationtype:10 a eCH-0265:CultivationType ;
    schema:name "Weitere Flächen innerhalb der landwirtschaftlichen Nutzfläche"@de,
        "Other areas within the agricultural land area"@en,
        "Autres surfaces comprises dans la surface agricole utile"@fr,
        "Altre superfici all’interno della superficie agricola utile"@it ;
    rdfs:subClassOf eCH-0265:Cultivation .

cultivationtype:12 a eCH-0265:CultivationType ;
    schema:name "Flächen ausserhalb der landwirtschaftlichen Nutzfläche"@de,
        "Areas outside of agricultural land"@en,
        "Surfaces en dehors de la surface agricole utile"@fr,
        "Superfici fuori della superficie agricola utilizzata"@it ;
    rdfs:subClassOf eCH-0265:Cultivation .

cultivationtype:13 a eCH-0265:CultivationType ;
    schema:name "Sömmerungsfläche"@de,
        "Summer grazing area"@en,
        "Surface d’estivage"@fr,
        "Superfici d’estivazione"@it ;
    schema:description "Als Sömmerungsfläche gelten die Gemeinschaftsweiden, Sömmerungsweiden und Heuwiesen, deren Ertrag für die Zufütterung während der Sömmerung verwendet wird (Art. 24 LBV)."@de ;
    rdfs:subClassOf eCH-0265:Cultivation ;
    owl:disjointWith cultivationtype:21 , cultivationtype:601, cultivationtype:464 .

cultivationtype:14 a eCH-0265:CultivationType ;
    schema:name "Getreide"@de,
        "Cereals"@en,
        "Céréales"@fr,
        "Cereali"@it ;
    schema:description "Der Anbau von verschiedenen Getreidearten wie Weizen, Gerste, Roggen, Hafer oder Dinkel. Das Hauptziel ist die Gewinnung der Körner zur Nutzung als Lebens- oder Futtermittel."@de ;
    rdfs:subClassOf cultivationtype:1 .

cultivationtype:15 a eCH-0265:CultivationType ;
    schema:name "Leguminosen"@de,
        "Legumes"@en,
        "Légumineuses"@fr,
        "Leguminose"@it ;
    schema:alternateName "Hülsenfrüchte"@de ;
    schema:description "Der Anbau von Pflanzen aus der Familie der Hülsenfrüchtler (Leguminosae). Das Ziel ist typischerweise die Gewinnung der Körner zur menschlichen Ernährung oder als Tierfutter."@de ;
    rdfs:subClassOf cultivationtype:1 .

cultivationtype:16 a eCH-0265:CultivationType ;
    schema:name "Pseudogetreide"@de,
        "Pseudocereals"@en,
        "Pseudo-céréales"@fr,
        "Pseudocereali"@it ;
    rdfs:subClassOf cultivationtype:1 .

cultivationtype:17 a eCH-0265:CultivationType ;
    schema:name "Hackfrüchte"@de,
        "Root crops"@en,
        "Plantes sarclées"@fr,
        "Colture sarchiate"@it ;
    rdfs:subClassOf cultivationtype:1022 .

cultivationtype:18 a eCH-0265:CultivationType ;
    schema:name "Mischkultur"@de,
        "Mixed crops"@en,
        "Cultures associées"@fr,
        "Colture consociate"@it ;
    rdfs:subClassOf cultivationtype:1 .

cultivationtype:19 a eCH-0265:CultivationType ;
    schema:name "Wintergetreide"@de,
        "Winter cereals"@en,
        "Céréales d'automne"@fr,
        "Cereali autunnali"@it ;
    rdfs:subClassOf cultivationtype:1033 .

cultivationtype:20 a eCH-0265:CultivationType ;
    schema:name "Einzelelemente"@de,
        "Individual elements"@en,
        "Éléments isolés"@fr,
        "Elementi isolati"@it ;
    rdfs:subClassOf eCH-0265:Cultivation .

cultivationtype:21 a eCH-0265:CultivationType ;
    schema:name "Dauergrünfläche"@de,
        "Permanent grassland"@en,
        "Surface herbagère permanente"@fr,
        "Superficie inerbita permanente"@it ;
    schema:alternateName "Dauergrünland"@de ;
    schema:description "Als Dauergrünfläche gilt die mit Gräsern und Kräutern bewachsene Fläche ausserhalb der Sömmerungsflächen. Sie besteht seit mehr als sechs Jahren als Dauerwiese oder als Dauerweide (Art. 19 LBV)."@de ;
    rdfs:subClassOf cultivationtype:114, cultivationtype:464 .

cultivationtype:22 a eCH-0265:CultivationType ;
    schema:name "Gemüsebau"@de,
        "Vegetable production"@en,
        "Culture maraîchère"@fr,
        "Orticoltura"@it ;
    rdfs:subClassOf cultivationtype:464 ;
    owl:unionOf (
        cultivationtype:23
        cultivationtype:24
        cultivationtype:540
    ) .

cultivationtype:23 a eCH-0265:CultivationType ;
    schema:name "Gemüsekulturen in geschütztem Anbau"@de,
        "Vegetable crops in protected cultivation"@en,
        "Cultures maraîchères sous abri"@fr,
        "Colture orticole in coltura protetta"@it ;
    rdfs:subClassOf cultivationtype:22 ;
    owl:unionOf (
        cultivationtype:801
        cultivationtype:806
    ) .

cultivationtype:24 a eCH-0265:CultivationType ;
    schema:name "Freilandgemüse"@de,
        "Open field vegetables"@en,
        "Légumes de plein champ"@fr,
        "Ortaggi di pieno campo"@it ;
    rdfs:subClassOf cultivationtype:22 ;
    owl:disjointWith cultivationtype:23 .

# Declare that all specific vegetable cultivation types are mutually exclusive
[] a owl:AllDisjointClasses ;
    owl:members (
        cultivationtype:545
        cultivationtype:546
        cultivationtype:801
        cultivationtype:806
    ) .

