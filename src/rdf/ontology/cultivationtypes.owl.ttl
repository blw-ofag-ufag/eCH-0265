        "Colture speciali"@it ;
    schema:description "Als Spezialkulturen gelten Reben, Hopfen, Obstanlagen, Beeren, Gemüse ausser Konservengemüse, Tabak, Heil- und Gewürzpflanzen sowie Pilze."@de ;
    rdfs:subClassOf cultivationtype:464 .

