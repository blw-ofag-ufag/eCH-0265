# ==============================================================================
# PREFIXES USED FOR THIS PROJECT
# ==============================================================================

# Project-specific namespaces/qnames
@prefix eCH-0265:        <https://agriculture.ld.admin.ch/eCH-0265/2/> .
@prefix naebi:           <https://agriculture.ld.admin.ch/crops/naebi/1/> .
@prefix cultivationtype: <https://agriculture.ld.admin.ch/crops/cultivationtype/> .

# LINDAS-specific namespaces/qnames
@prefix org:             <https://register.ld.admin.ch/opendataswiss/org/> .
@prefix theme:           <https://register.ld.admin.ch/opendataswiss/category/> .

# Globally used namespaces/qnames
@prefix dcat:            <http://www.w3.org/ns/dcat#> .
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix frequency:       <https://publications.europa.eu/resource/authority/frequency/> .
@prefix schema:          <http://schema.org/> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard:           <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# DATASET METADATA
# ==============================================================================

naebi:ConceptScheme a eCH-0265:NutrientBalanceCropScheme ;
    schema:name "Suisse-Bilanz Kulturentabelle"@de ;
    schema:description "Kulturen der Suisse-Bilanz und ihre Codes gemäss Wegleitung."@de ;
    schema:creator org:bundesamt-fur-landwirtschaft-blw ;
    schema:publisher org:bundesamt-fur-landwirtschaft-blw ;
    schema:dateCreated "1999-01-01"^^xsd:date ;
    schema:dateModified "2026-08-07"^^xsd:date ;
    dcterms:accrualPeriodicity frequency:ANNUAL ;
    schema:version "1.20" ;
    dcat:contactPoint
        [
            a vcard:Organization ;
            vcard:fn "Bundesamt für Landwirtschaft"@de ;
            vcard:hasEmail "info@blw.admin.ch"
        ] ;
    dcat:theme theme:administration,
        theme:agriculture .

# ==============================================================================
# NUTRIENT BALANCE CROP CATEGORIES
# ==============================================================================

naebi:ARABLE a eCH-0265:NutrientBalanceCropCategory ;
    skos:inScheme naebi:ConceptScheme ;
    skos:topConceptOf naebi:ConceptScheme ;
    schema:identifier "CULT_ARABLE" ;
    schema:name "Ackerkulturen"@de,
        "Grandes cultures"@fr,
        "Colture campicole"@it ;
    eCH-0265:exactMatch cultivationtype:1 .

naebi:FODDER a eCH-0265:NutrientBalanceCropCategory ;
    skos:inScheme naebi:ConceptScheme ;
    skos:topConceptOf naebi:ConceptScheme ;
    schema:identifier "CULT_FODDER" ;
    schema:name "Grundfutterproduktion"@de,
        "Production fourragères de base"@fr,
        "Produzione di foraggi di base"@it ;
    eCH-0265:exactMatch cultivationtype:463 .

naebi:SPECIAL a eCH-0265:NutrientBalanceCropCategory ;
    skos:inScheme naebi:ConceptScheme ;
    skos:topConceptOf naebi:ConceptScheme ;
    schema:identifier "CULT_SPECIAL" ;
    schema:name "Spezialkulturen"@de,
        "Cultures spéciales"@fr,
        "Colture speciali"@it ;
    eCH-0265:exactMatch cultivationtype:465 .

