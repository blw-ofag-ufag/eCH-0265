naebi:ConceptScheme a skos:ConceptScheme ;
    schema:name "Suisse-Bilanz Kulturentabelle"@de ;
    schema:description "Kulturen der Suisse-Bilanz und ihre Codes gemäss Wegleitung."@de ;
    schema:creator org:bundesamt-fur-landwirtschaft-blw ;
    schema:publisher org:bundesamt-fur-landwirtschaft-blw ;
    schema:dateCreated "1999-01-01"^^xsd:date ;
    schema:dateModified "2026-07-27"^^xsd:date ;
    dcterms:accrualPeriodicity frequency:ANNUAL ;
    schema:version "1.20" ;
    dcat:contactPoint
        [
            a vcard:Organization ;
            vcard:fn "Bundesamt für Landwirtschaft"@de ;
            vcard:hasEmail "info@blw.admin.ch"
        ] ;
    dcat:theme theme:administration,
        theme:agriculture .

