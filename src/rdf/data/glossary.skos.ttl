# ==============================================================================
# PREFIXES
# ==============================================================================

# Project-specific namespaces/qnames
@prefix eCH-0265:        <https://agriculture.ld.admin.ch/eCH-0265/2/> .
@prefix term:            <https://agriculture.ld.admin.ch/eCH-0265/2/term/> .

# Globally used namespaces/qnames
@prefix schema:          <http://schema.org/> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .

# ==============================================================================
# GLOSSARY METADATA
# ==============================================================================

eCH-0265:glossary a skos:ConceptScheme ;
    schema:name "Glossar des Standards eCH-0265"@de ;
    schema:description "Diese Glossar soll sämtliche verwendeten Fachbegriffe inklusive Abkürzungen des Standards eCH-0265 enthalten."@de .

# ==============================================================================
# GLOSSARY TERMS
# ==============================================================================

term:agis a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Agrarpolitisches Informationssystem"@de ;
    schema:alternateName "AGIS"@de ;
    schema:description "Das agrarpolitische Informationssystem des Bundes, an welches im Rahmen der Strukturdatenerhebung Daten zu Direktzahlungskulturen übermittelt werden."@de .

term:kais a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Kantonales Agrarinformationssystem"@de ;
    schema:alternateName "KAIS"@de ;
    schema:description "Informationssystem auf Kantonsebene, in welches Bewirtschaftende im Rahmen der Strukturdatenerhebung ihre Daten eintragen."@de .

term:lindas a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Linked Data Service"@de ;
    schema:alternateName "LINDAS"@de ;
    schema:description "Der offizielle Linked-Data-Dienst der Schweizer Bundesverwaltung, der als Triple Store fungiert."@de .

term:nbbs a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Nährstoffbilanz-Berechnungsservice"@de ;
    schema:alternateName "NBBS"@de ;
    schema:description "Eine vom Bundesamt für Landwirtschaft bereitgestellte RESTful API zur Standardisierung der Suisse-Bilanz-Berechnung."@de .

term:srppp a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Pflanzenschutzmittelverzeichnis"@de ;
    schema:alternateName "PSM-V"@de ;
    schema:description "Das offizielle Register des Bundes, gepflegt vom BLV, das alle in der Schweiz zugelassenen Pflanzenschutzmittel sowie deren rechtmässigen Einsatzbereich auflistet."@de .

term:rdf a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Resource Description Framework"@de ;
    schema:alternateName "RDF"@de ;
    schema:description "Ein zentraler Standard des World Wide Web Consortiums (W3C) zur Modellierung von Datenstrukturen im Web. Informationen werden nicht in klassischen Tabellen, sondern als vernetzte Graphen abgebildet."@de .

term:skos a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Simple Knowledge Organization System"@de ;
    schema:alternateName "SKOS"@de .

term:suibi a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Suisse-Bilanz"@de ;
    schema:description "Zentrales Berechnungsinstrument, das den Nährstoffanfall und -bedarf auf Betriebsebene systematisch gegenüberstellt, um eine ausgeglichene Nährstoffbilanz auszuweisen."@de .

term:triple a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:broader term:rdf ;
    schema:name "Tripel"@de ;
    schema:description "Die Grundstruktur einer Aussage in RDF, bestehend aus Subjekt, Prädikat und Objekt."@de .

# ==============================================================================
# FACHBEREICHE UND ORGANISATIONEN
# ==============================================================================

term:dz a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Direktzahlungen"@de ;
    schema:alternateName "DZ"@de ;
    schema:description "Beiträge des Bundes an Landwirtschaftsbetriebe gemäss Direktzahlungsverordnung. In diesem Dokument zugleich Kurzbezeichnung für den Fachbereich und dessen Kulturliste, die Direktzahlungskulturen."@de .

term:nb a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Nährstoffbilanz"@de ;
    schema:alternateName "NB"@de ;
    schema:description "Gegenüberstellung von Nährstoffanfall und Nährstoffbedarf eines Landwirtschaftsbetriebs, berechnet mit der Suisse-Bilanz. In diesem Dokument zugleich Kurzbezeichnung für den Fachbereich und dessen Kulturliste aus dem Nährstoffbilanz-Berechnungsservice."@de .

term:psm a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Pflanzenschutzmittel"@de ;
    schema:alternateName "PSM"@de ;
    schema:description "Mittel zum Schutz von Pflanzen vor Schadorganismen. In diesem Dokument zugleich Kurzbezeichnung für den Fachbereich Pflanzenschutz und dessen Kulturliste aus dem Pflanzenschutzmittelverzeichnis."@de .

term:blw a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Bundesamt für Landwirtschaft"@de ;
    schema:alternateName "BLW"@de ;
    schema:description "Zuständige Bundesstelle für die Direktzahlungen und die Nährstoffbilanz; Herausgeberin dieses Hilfsmittels."@de .

term:blv a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Bundesamt für Lebensmittelsicherheit und Veterinärwesen"@de ;
    schema:alternateName "BLV"@de ;
    schema:description "Zuständige Bundesstelle für das Pflanzenschutzmittelverzeichnis."@de .

term:ech a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Verein eCH"@de ;
    schema:alternateName "eCH"@de ;
    schema:description "Verein zur Förderung von E-Government-Standards in der Schweiz. Er publiziert Standards und Hilfsmittel wie das vorliegende Dokument."@de .

term:eppo a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "European and Mediterranean Plant Protection Organization"@de ;
    schema:alternateName "EPPO"@de ;
    schema:description "Zwischenstaatliche Organisation für Pflanzenschutz, von deren Kulturhierarchie die Struktur des Pflanzenschutzmittelverzeichnisses ursprünglich abgeleitet wurde."@de .

term:w3c a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "World Wide Web Consortium"@de ;
    schema:alternateName "W3C"@de ;
    schema:description "Standardisierungsgremium für das World Wide Web, das unter anderem RDF, SKOS, OWL, SHACL und SPARQL spezifiziert."@de .

# ==============================================================================
# FACHBEGRIFFE DER LANDWIRTSCHAFT
# ==============================================================================

term:lbv a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Landwirtschaftliche Begriffsverordnung"@de ;
    schema:alternateName "LBV"@de ;
    schema:description "Verordnung über landwirtschaftliche Begriffe und die Anerkennung von Betriebsformen (SR 910.91), welche unter anderem die Flächenkategorien der Direktzahlungen definiert."@de .

term:ln a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Landwirtschaftliche Nutzfläche"@de ;
    schema:alternateName "LN"@de ;
    schema:description "Die einem Betrieb zugeordnete, für den Pflanzenbau genutzte Fläche gemäss Art. 14 LBV; eine der vier Wurzeln der Referenztaxonomie."@de .

term:oeln a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Ökologischer Leistungsnachweis"@de ;
    schema:alternateName "ÖLN"@de ;
    schema:description "Die ökologischen Mindestanforderungen, die ein Betrieb für den Bezug von Direktzahlungen erfüllen muss; dazu gehört eine ausgeglichene Nährstoffbilanz."@de .

term:grud a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Grundlagen für die Düngung landwirtschaftlicher Kulturen in der Schweiz"@de ;
    schema:alternateName "GRUD"@de ;
    schema:description "Fachliche Empfehlungen zum Nährstoffbedarf der Kulturen, auf die sich die Suisse-Bilanz stützt."@de .

term:hilfsmittel a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Hilfsmittel"@de ;
    schema:description "Dokumenttyp von eCH ohne normative Kraft, der die Anwendung von Standards unterstützt. Das vorliegende Dokument ist ein Hilfsmittel."@de .

# ==============================================================================
# BEGRIFFE DES DATENMODELLS
# ==============================================================================

term:cultivationtype a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Nutzungstyp"@de ;
    schema:description "Bereichsübergreifend definierte Form der Landnutzung in der Referenztaxonomie von eCH-0265, auf die alle Kulturen der Fachbereiche verweisen."@de .

term:referencetaxonomy a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Referenztaxonomie"@de ;
    schema:description "Die hierarchisch geordnete Gesamtheit der Nutzungstypen. Sie verbindet die Kulturlisten der Fachbereiche miteinander, trägt selbst aber keine fachlichen oder rechtlichen Eigenschaften."@de .

term:conceptscheme a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Konzeptschema"@de ;
    schema:description "Eine in sich geschlossene Sammlung von Begriffen (Konzepten) nach SKOS. Jede Kulturliste eines Fachbereichs bildet ein eigenes Konzeptschema."@de .

term:mapping a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Mapping-Tabelle"@de ;
    schema:description "Tabelle der abgeleiteten Beziehungen zwischen den Kulturen zweier Fachbereiche, ausgedrückt als exakte, allgemeinere oder spezifischere Entsprechung."@de .

term:linkeddata a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Linked Data"@de ;
    schema:description "Publikationsform strukturierter Daten im Web, bei der jede Ressource über eine eindeutige Webadresse identifiziert und mit anderen Ressourcen verknüpft ist."@de .

# ==============================================================================
# TECHNISCHE STANDARDS
# ==============================================================================

term:iri a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Internationalized Resource Identifier"@de ;
    schema:alternateName "IRI"@de ;
    schema:description "Weltweit eindeutiger Identifikator einer Ressource in Form einer Webadresse. Jede Kultur und jeder Nutzungstyp in eCH-0265 besitzt einen dauerhaften IRI."@de .

term:owl a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Web Ontology Language"@de ;
    schema:alternateName "OWL"@de ;
    schema:description "Standard des W3C zur formalen Beschreibung von Begriffen und ihren logischen Beziehungen; wird für die Referenztaxonomie verwendet."@de .

term:shacl a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Shapes Constraint Language"@de ;
    schema:alternateName "SHACL"@de ;
    schema:description "Standard des W3C zur Formulierung und Prüfung von Regeln für RDF-Daten; die Klassenreferenz dieses Dokuments ist daraus generiert."@de .

term:sparql a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "SPARQL Protocol and RDF Query Language"@de ;
    schema:alternateName "SPARQL"@de ;
    schema:description "Abfragesprache des W3C für RDF-Daten, mit der die Daten von LINDAS bezogen werden."@de .

term:api a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Application Programming Interface"@de ;
    schema:alternateName "API"@de ;
    schema:description "Programmierschnittstelle, über die ein System Daten oder Funktionen für andere Systeme bereitstellt."@de .

term:uml a skos:Concept ;
    skos:inScheme eCH-0265:glossary ;
    skos:topConceptOf eCH-0265:glossary ;
    schema:name "Unified Modeling Language"@de ;
    schema:alternateName "UML"@de ;
    schema:description "Standardisierte grafische Notation zur Darstellung von Datenmodellen."@de .
