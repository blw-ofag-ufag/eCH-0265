# ==============================================================================
# DATASET METADATA
# ------------------------------------------------------------------------------
# Catalogue of land use types (LNF_Katalog_Nutzungsart) of the minimal geodata
# model (MGDM) «Landwirtschaftliche Kulturflächen» (geodata identifier 153,
# model 153.1 Nutzungsflächen), published by the Federal Office for Agriculture
# at https://models.geo.admin.ch/BLW/LWB_Nutzungsflaechen_Kataloge_V3_0.xml
# ==============================================================================

mgdm:ConceptScheme a eCH-0265:GeodataCropScheme ;
    schema:name "Nutzungsarten der landwirtschaftlichen Kulturflächen"@de,
        "Land use types of agricultural cultivation areas"@en ;
    schema:description "Katalog der Nutzungsarten (LNF_Katalog_Nutzungsart) gemäss dem minimalen Geodatenmodell «Landwirtschaftliche Kulturflächen» (Identifikator 153, Modell 153.1 Nutzungsflächen), inklusive Hauptkategorien, Attributen und zeitlicher Gültigkeit der LNF-Codes."@de,
        "Catalogue of land use types (LNF_Katalog_Nutzungsart) according to the minimal geodata model «Agricultural cultivation areas» (identifier 153, model 153.1 Nutzungsflächen), including main categories, attributes and temporal validity of the LNF codes."@en ;
    schema:identifier "153.1" ;
    schema:url <https://models.geo.admin.ch/BLW/LWB_Nutzungsflaechen_Kataloge_V3_0.xml> ;
    schema:creator org:bundesamt-fur-landwirtschaft-blw ;
    schema:publisher org:bundesamt-fur-landwirtschaft-blw ;
    schema:dateCreated "2023-01-01"^^xsd:date ;
    schema:dateModified "2025-02-19"^^xsd:date ;
    dcterms:accrualPeriodicity frequency:ANNUAL ;
    schema:version "3.0" ;
    dcat:contactPoint
        [
            a vcard:Organization ;
            vcard:fn "Bundesamt für Landwirtschaft"@de ;
            vcard:hasEmail "geodaten@blw.admin.ch"
        ] ;
    dcat:theme theme:administration,
        theme:agriculture,
        theme:geography .

# ==============================================================================
# Hauptkategorien der Nutzungsflächen
# ==============================================================================

mgdm:ArableLand a eCH-0265:GeodataCropCategory ;
    schema:name "Ackerfläche"@de,
        "Terres cultivées"@fr,
        "Superficie coltiva"@it ;
    skos:topConceptOf mgdm:ConceptScheme ;
    skos:inScheme mgdm:ConceptScheme ;
    eCH-0265:exactMatch cultivationtype:1 .

